{
    "name": "container-viewer",
    "version": "2.1.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/boardgamers/container.git",
        "directory": "viewer"
    },
    "scripts": {
        "serve": "vite --host 0.0.0.0",
        "build": "vite build",
        "test:unit": "vitest run",
        "package": "vite build --mode library && vite build --mode library-readable",
        "prepublishOnly": "npm run package",
        "test:browser": "node scripts/protocol-smoke.mjs",
        "test:offshore:browser": "node scripts/offshore-smoke.mjs",
        "test:tutorial": "node --test tests/tutorial/lessons.cjs",
        "check": "tsc --noEmit",
        "test:tutorial:browser": "node scripts/tutorial-smoke.mjs",
        "preview:tutorial": "node scripts/tutorial-preview.mjs"
    },
    "dependencies": {
        "@boardgamers/protocol": "0.11.0",
        "assert": "^2.1.0",
        "container-engine": "workspace:../engine",
        "core-js": "^3.6.5",
        "events": "^3.3.0",
        "lodash": "^4.17.19",
        "process": "^0.11.10",
        "regenerator-runtime": "^0.13.7",
        "tslib": "^2.2.0",
        "vue": "2.7.16",
        "vue-class-component": "^7.2.3",
        "vue-property-decorator": "^9.1.2"
    },
    "devDependencies": {
        "@rollup/plugin-inject": "^5.0.5",
        "@types/assert": "^1.4.7",
        "@types/chai": "^4.2.11",
        "@types/events": "^3.0.0",
        "@types/lodash": "^4.14.154",
        "@types/node": "^24.0.0",
        "@typescript-eslint/parser": "^4.26.1",
        "@vitejs/plugin-vue2": "2.3.4",
        "@vue/test-utils": "^1.3.6",
        "chai": "^4.5.0",
        "csstype": "^3.2.3",
        "esbuild": "0.25.12",
        "eslint": "^7.28.0",
        "eslint-plugin-vue": "^7.11.0",
        "jsdom": "^28.0.0",
        "playwright": "1.62.1",
        "sass": "^1.97.0",
        "typescript": "^5.9.3",
        "vite": "7.2.0",
        "vitest": "^4.1.0",
        "vue-template-compiler": "2.7.16",
        "zod": "^4.6.2"
    },
    "files": [
        "src",
        "dist/container-viewer.umd.min.js",
        "dist/container-viewer.css",
        "dist/img",
        "dist/media",
        "tsconfig.json",
        "public/audio",
        "dist/container-viewer.umd.min.locale-*.js"
    ]
}
